<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="VerifySharedPlmBrandAssets" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\pdm-ui\tools\Verify-PlmIconAssets.ps1&quot; -ProjectRoot &quot;$(MSBuildThisFileDirectory)..\..&quot;" />
  </Target>
</Project>
