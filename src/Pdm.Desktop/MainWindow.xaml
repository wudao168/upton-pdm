<Window x:Class="Upton.Pdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="UPTON PDM 客户端"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid>
        <wv2:WebView2 x:Name="WorkspaceView" />

        <Border x:Name="LoadingPanel" Background="#F4F6F8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="UPTON PDM" FontSize="26" FontWeight="SemiBold" Foreground="#19242D" HorizontalAlignment="Center" />
                <TextBlock Text="正在加载设计资料中心…" Margin="0,12,0,0" FontSize="14" Foreground="#6E7D88" HorizontalAlignment="Center" />
                <ProgressBar Margin="0,20,0,0" Width="220" Height="4" IsIndeterminate="True" Foreground="#D68021" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
