<Window x:Class="Upton.Pdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/PdmClient.ico"
        Title="UPLM 产品生命周期管理"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E5E7EB">
            <Border.Resources>
                <Style x:Key="CaptionButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#1F2937" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background" Value="#D1D5DB" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background" Value="#C5CAD1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <StackPanel Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,7,0"
                           Source="Assets/PdmClient.ico" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#1F2937"
                               FontSize="12"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="OnMinimizeButtonClick"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;" />
                    </Button>
                    <Button Click="OnMaximizeButtonClick"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最大化/还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE923;" />
                    </Button>
                    <Button Click="OnCloseButtonClick"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <wv2:WebView2CompositionControl x:Name="WorkspaceView" Grid.Row="1" />

        <Canvas x:Name="PreviewOverlay" Grid.Row="1" Panel.ZIndex="20" IsHitTestVisible="True">
            <Border x:Name="PreviewFrame"
                    Visibility="Collapsed"
                    Background="#EDF3F8"
                    BorderBrush="#CBD8E5"
                    BorderThickness="1">
                <Grid>
                    <wfi:WindowsFormsHost x:Name="EmbeddedPreviewHost" />
                </Grid>
            </Border>
        </Canvas>

        <Border x:Name="LoadingPanel" Grid.Row="1" Panel.ZIndex="100" Background="#FFFFFF">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                <Grid Width="136" Height="136">
                    <Viewport3D x:Name="LoadingCubeViewport"
                                Width="112"
                                Height="112"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,3.15"
                                               LookDirection="0,0,-3.15"
                                               UpDirection="0,1,0"
                                               FieldOfView="34" />
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="LoadingCubeVisual" />
                    </Viewport3D>
                </Grid>
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#27364A"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="UPLM 产品生命周期管理" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
