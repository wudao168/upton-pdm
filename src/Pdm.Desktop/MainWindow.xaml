<Window x:Class="Upton.Pdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/PdmClient.ico"
        Title="UPLM 产品生命周期管理"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E5E7EB">
            <Border.Resources>
                <Style x:Key="CaptionButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#1F2937" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background" Value="#D1D5DB" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background" Value="#C5CAD1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <StackPanel Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,7,0"
                           Source="Assets/PdmClient.ico" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#1F2937"
                               FontSize="12"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="OnMinimizeButtonClick"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;" />
                    </Button>
                    <Button Click="OnMaximizeButtonClick"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最大化/还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE923;" />
                    </Button>
                    <Button Click="OnCloseButtonClick"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="最小化到托盘（退出请右键托盘图标）"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <wv2:WebView2CompositionControl x:Name="WorkspaceView" Grid.Row="1" />

        <Canvas x:Name="PreviewOverlay" Grid.Row="1" Panel.ZIndex="20" IsHitTestVisible="True">
            <Border x:Name="PreviewFrame"
                    Visibility="Collapsed"
                    Background="#EDF3F8"
                    BorderBrush="#CBD8E5"
                    BorderThickness="1">
                <Grid>
                    <wfi:WindowsFormsHost x:Name="EmbeddedPreviewHost" />
                </Grid>
            </Border>
        </Canvas>

        <Border x:Name="LoadingPanel" Grid.Row="1" Panel.ZIndex="100" Background="#FFFFFF">
            <Grid>
                <!-- 工业风底纹：蓝图网格 + 齿轮轮廓，与网页端登录页保持一致的视觉语言 -->
                <Rectangle Opacity="0.55">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Stretch="None">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#D7E3EF" Thickness="1" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                                            <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Path HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="72,86,0,0"
                      Data="M0,44 A44,44 0 1 1 88,44 A44,44 0 1 1 0,44 M30,44 A14,14 0 1 1 58,44 A14,14 0 1 1 30,44 M44,-6 V6 M44,82 V94 M-6,44 H6 M82,44 H94"
                      Stroke="#C3D5E6"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LoadingGearRotation" CenterX="44" CenterY="44" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="LoadingGearRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:24" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <Path HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,86,104"
                      Data="M0,28 A28,28 0 1 1 56,28 A28,28 0 1 1 0,28 M20,28 A8,8 0 1 1 36,28 A8,8 0 1 1 20,28 M28,0 V6 M28,50 V56 M0,28 H6 M50,28 H56"
                      Stroke="#CFDFEE"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LoadingGearRotationSecondary" CenterX="28" CenterY="28" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="LoadingGearRotationSecondary"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="360"
                                                     To="0"
                                                     Duration="0:0:32" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                    <Image Width="132"
                           Height="132"
                           HorizontalAlignment="Center"
                           Source="Assets/PdmClient.ico"
                           Stretch="Uniform" />
                    <Grid Width="112" Height="112" Margin="0,14,0,0">
                    <Viewport3D x:Name="LoadingCubeViewport"
                                Width="112"
                                Height="112"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,3.15"
                                               LookDirection="0,0,-3.15"
                                               UpDirection="0,1,0"
                                               FieldOfView="34" />
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="LoadingCubeVisual" />
                    </Viewport3D>
                    </Grid>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#27364A"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="UPLM 产品生命周期管理" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#6B7C91"
                               FontSize="12"
                               Text="正在加载设计协同工作台…" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
