<Window x:Class="Upton.Pdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/PdmClient.ico"
        Title="UPLM 产品生命周期管理"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid x:Name="RootGrid">
        <wv2:WebView2CompositionControl x:Name="WorkspaceView" />

        <Canvas x:Name="PreviewOverlay" Panel.ZIndex="20" IsHitTestVisible="True">
            <Border x:Name="PreviewFrame"
                    Visibility="Collapsed"
                    Background="#EDF3F8"
                    BorderBrush="#CBD8E5"
                    BorderThickness="1">
                <Grid>
                    <wfi:WindowsFormsHost x:Name="EmbeddedPreviewHost" />
                </Grid>
            </Border>
        </Canvas>

        <Border x:Name="LoadingPanel" Panel.ZIndex="100" Background="#FFFFFF">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                <Grid Width="136" Height="136">
                    <Canvas Width="96"
                            Height="96"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Canvas.RenderTransform>
                        <Rectangle x:Name="LoadingSquare1"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#FF3D00"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                        <Rectangle x:Name="LoadingSquare2"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#FF9800"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                        <Rectangle x:Name="LoadingSquare3"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#FFDF33"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                        <Rectangle x:Name="LoadingSquare4"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#49B653"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                        <Rectangle x:Name="LoadingSquare5"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#2495E8"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                        <Rectangle x:Name="LoadingSquare6"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#F8FAFC"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                        <Rectangle x:Name="LoadingSquare7"
                                   Width="28"
                                   Height="28"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Fill="#2495E8"
                                   Stroke="#071936"
                                   StrokeThickness="0.5" />
                    </Canvas>
                </Grid>
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#27364A"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="UPLM 产品生命周期管理" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
