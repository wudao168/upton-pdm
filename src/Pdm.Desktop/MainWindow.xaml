<Window x:Class="Upton.Pdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/PdmClient.ico"
        Title="UPLM 产品生命周期管理"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid x:Name="RootGrid">
        <wv2:WebView2CompositionControl x:Name="WorkspaceView" />

        <Canvas x:Name="PreviewOverlay" Panel.ZIndex="20" IsHitTestVisible="True">
            <Border x:Name="PreviewFrame"
                    Visibility="Collapsed"
                    Background="#EDF3F8"
                    BorderBrush="#CBD8E5"
                    BorderThickness="1">
                <Grid>
                    <wfi:WindowsFormsHost x:Name="EmbeddedPreviewHost" />
                </Grid>
            </Border>
        </Canvas>

        <Border x:Name="LoadingPanel" Panel.ZIndex="100" Background="#FFFFFF">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                <Grid Width="136" Height="136">
                    <Viewport3D x:Name="LoadingCubeViewport"
                                Width="112"
                                Height="112"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,3.15"
                                               LookDirection="0,0,-3.15"
                                               UpDirection="0,1,0"
                                               FieldOfView="34" />
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="LoadingCubeVisual" />
                    </Viewport3D>
                </Grid>
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#27364A"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="UPLM 产品生命周期管理" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
