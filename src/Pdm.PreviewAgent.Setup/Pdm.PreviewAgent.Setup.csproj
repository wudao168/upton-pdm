<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Upton.Pdm.PreviewAgent.Setup</RootNamespace>
    <AssemblyName>Upton.Pdm.PreviewAgent.Setup</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.generated\agent\*" LogicalName="payload.agent.%(Filename)%(Extension)" />
    <EmbeddedResource Include="payload.generated\preview-worker\*" LogicalName="payload.worker.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="EnsurePreviewAgentPayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('payload.generated\agent\Upton.Pdm.PreviewAgent.exe')"
           Text="缺少 payload.generated 载荷：请先运行 .local\Build-PreviewAgentSetup-20260920.ps1（它会调用 Build-PreviewAgentPackage）。" />
  </Target>
</Project>
