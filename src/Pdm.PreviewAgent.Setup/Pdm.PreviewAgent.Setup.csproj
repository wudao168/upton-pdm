<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Upton.Pdm.PreviewAgent.Setup</RootNamespace>
    <AssemblyName>Upton.Pdm.PreviewAgent.Setup</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationIcon>..\Pdm.Desktop\Assets\PdmClient.ico</ApplicationIcon>
    <PreviewAgentPayloadRoot Condition="'$(PreviewAgentPayloadRoot)' == ''">payload.generated</PreviewAgentPayloadRoot>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Pdm.Client.Shared\ClientLogRedaction.cs" Link="ClientLogRedaction.cs" />
    <EmbeddedResource Include="$(PreviewAgentPayloadRoot)\agent\*" LogicalName="payload.agent.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PreviewAgentPayloadRoot)\preview-worker\*" LogicalName="payload.worker.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PreviewAgentPayloadRoot)\upgrade\*" LogicalName="upgrade.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="EnsurePreviewAgentPayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PreviewAgentPayloadRoot)\agent\Upton.Pdm.PreviewAgent.exe')"
           Text="缺少安装载荷，请先运行 deploy\New-PreviewAgentSetup.ps1。" />
  </Target>
  <Import Project="..\Pdm.Client.Shared\PlmBrandAssets.targets" />
</Project>
