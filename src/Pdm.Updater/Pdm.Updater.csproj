<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>UPLM.Updater</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="../Pdm.Client.Shared/ClientUpdateState.cs" Link="ClientUpdateState.cs" />
    <EmbeddedResource Include="$(UplmUpdatePublicKeyFile)" LogicalName="UPLM.Update.PublicKey" Condition="'$(UplmUpdatePublicKeyFile)' != ''" />
  </ItemGroup>
</Project>
